<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <FontFamily x:Key="UiFontFamily">../fonts/MinecraftDefault-Regular.ttf#MinecraftDefault</FontFamily>
    <FontFamily x:Key="CodeFontFamily">../fonts/MinecraftDefault-Regular.ttf#MinecraftDefault</FontFamily>
    <sys:Double x:Key="UiFontSize">12</sys:Double>
    <CornerRadius x:Key="CardRadius">2</CornerRadius>
    <CornerRadius x:Key="ControlRadius">1</CornerRadius>
    <CornerRadius x:Key="SmallRadius">1</CornerRadius>
    <CornerRadius x:Key="IconButtonRadius">2</CornerRadius>
    <sys:Double x:Key="IslandRadiusScale">0.45</sys:Double>

    <LinearGradientBrush x:Key="IslandBrush" StartPoint="0,0" EndPoint="0.8,1">
        <GradientStop Color="#FA1B2B1B" Offset="0" />
        <GradientStop Color="#F0273F1D" Offset="0.52" />
        <GradientStop Color="#F0523825" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TextBrush" Color="#F7F6D8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#55FFFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2655FFFF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4055FFFF" />
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D83F5F2A" Offset="0" />
        <GradientStop Color="#D45A3A27" Offset="0.58" />
        <GradientStop Color="#D233332F" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ControlBrush" Color="#B84B4B45" />
    <SolidColorBrush x:Key="HoverBrush" Color="#D3607B34" />
    <SolidColorBrush x:Key="PressedBrush" Color="#E3312F2B" />
    <SolidColorBrush x:Key="TrackBrush" Color="#B72C2C28" />
    <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Color="#CCE6E6E6" Offset="0" />
        <GradientStop Color="#803A2418" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassMutedBrush" Color="#F1E7B6" />

    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#1B2B1B" />
    <SolidColorBrush x:Key="TerminalForegroundBrush" Color="#F7F6D8" />
    <SolidColorBrush x:Key="TerminalCursorBrush" Color="#55FFFF" />
    <SolidColorBrush x:Key="TerminalSelectionBrush" Color="#3F5F2A" />
    <SolidColorBrush x:Key="TerminalAnsi0Brush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="TerminalAnsi1Brush" Color="#AA0000" />
    <SolidColorBrush x:Key="TerminalAnsi2Brush" Color="#55AA00" />
    <SolidColorBrush x:Key="TerminalAnsi3Brush" Color="#FFAA00" />
    <SolidColorBrush x:Key="TerminalAnsi4Brush" Color="#5555FF" />
    <SolidColorBrush x:Key="TerminalAnsi5Brush" Color="#AA00AA" />
    <SolidColorBrush x:Key="TerminalAnsi6Brush" Color="#00AAAA" />
    <SolidColorBrush x:Key="TerminalAnsi7Brush" Color="#AAAAAA" />
    <SolidColorBrush x:Key="TerminalAnsi8Brush" Color="#555555" />
    <SolidColorBrush x:Key="TerminalAnsi9Brush" Color="#FF5555" />
    <SolidColorBrush x:Key="TerminalAnsi10Brush" Color="#55FF55" />
    <SolidColorBrush x:Key="TerminalAnsi11Brush" Color="#FFFF55" />
    <SolidColorBrush x:Key="TerminalAnsi12Brush" Color="#55FFFF" />
    <SolidColorBrush x:Key="TerminalAnsi13Brush" Color="#FF55FF" />
    <SolidColorBrush x:Key="TerminalAnsi14Brush" Color="#00FFFF" />
    <SolidColorBrush x:Key="TerminalAnsi15Brush" Color="#FFFFFF" />
</ResourceDictionary>
